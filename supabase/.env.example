# Example Supabase Edge Function Environment Variables
# Copy this file to .env and replace placeholders with actual values
# NEVER commit the actual .env file to version control!

YOUTUBE_API_KEY=your_youtube_api_key_here
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "your-project-id", "private_key_id": "...", "private_key": "...", "client_email": "..."}
